# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Secrets. gitleaks is the backstop, not the primary control (SECURITY.md c.6).
.env
.env.*
!.env.example
*.pem
*.key

# Corpora. DATA.md: corpora that cannot be redistributed are referenced by
# download script, never checked in. MANIFEST.yaml is the exception and is
# tracked, because the manifest is the record of what was not checked in.
data/*
!data/MANIFEST.yaml
!data/README.md

# Model artefacts live in object storage, never git (RULES.md).
*.safetensors
*.onnx
*.bin
*.pt
*.ckpt

# Run logs. The measured results (results/*.json) are committed; the raw
# logs are noisy HTTP chatter and are not.
eval/leakage/results/*.log

# Agent tooling runtime state. Daemon pids, logs and neural stats are
# machine local and change on every run; they are not project configuration.
.claude-flow/
.claude/settings.local.json

# OS / editor
.DS_Store
.idea/
.vscode/

# Injection suite checkpoint. A resume file for one run in progress, not a
# result: the completed run is written to results.json.
eval/injection/*.partial.jsonl

# Model artefacts. Fetched and verified by tools/export_embedder.py; the
# manifest records the pinned revision, so the directory is reproducible and
# does not belong in the tree.
models/

graphify-out/

# Local only, never pushed.
#
# The annotation set carries verbatim passages from the OOD corpus, which
# data/MANIFEST.yaml records as publisher copyright with redistribution
# prohibited. The file lives on this machine and nowhere else.
eval/annotation/passages.jsonl

# Working notes kept outside the published repository.
context/DECISIONS.md
tools/refresh_report.py
tests/test_refresh_report.py
