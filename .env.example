# Copy to .env and fill in. .env is gitignored; this template is not.
# Never commit a real value. gitleaks runs pre-commit as the backstop.

# --- Postgres -------------------------------------------------------------
POSTGRES_USER=provenance
POSTGRES_PASSWORD=change_me_before_running
POSTGRES_DB=provenance
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379

# --- Claim extraction (M2) ------------------------------------------------
# Put your real key here in .env, not in this file and not in chat.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Fetcher limits (SECURITY.md control 1 defaults) ----------------------
FETCH_CONNECT_TIMEOUT_S=5.0
FETCH_TOTAL_TIMEOUT_S=15.0
FETCH_MAX_REDIRECTS=3
FETCH_MAX_RESPONSE_BYTES=5242880
